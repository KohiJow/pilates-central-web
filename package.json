{
  "name": "pilates-central-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Agenda, presença, reposição, alunos, turmas e financeiro para estúdio pequeno, como web app instalável.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.teste.json && tsc -p tsconfig.node.json && tsc -p tsconfig.sw.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "icones": "node scripts/gerar-icones.mjs",
    "abertura": "node scripts/gerar-abertura.mjs",
    "regras": "firebase emulators:exec --only firestore --project demo-pilates \"vitest run --config vitest.regras.config.ts\""
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@preact/signals": "2.11.3",
    "firebase": "12.19.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.60.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  }
}
