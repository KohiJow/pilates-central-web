# Copie para .env.production.local (não vai para o repositório) e preencha com a configuração
# do app web do projeto Firebase (Console > Configurações do projeto > Seus apps).
# Sem estes valores, o site roda só em modo demonstração.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Chave do site do reCAPTCHA v3 (App Check). Vazia = App Check desligado (ver docs/firebase.md).
VITE_FIREBASE_APPCHECK_SITE_KEY=
